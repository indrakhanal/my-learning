generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum NoteStatus {
  DRAFT
  PUBLISHED
}

enum AttachmentKind {
  IMAGE
  FILE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  notes        Note[]
  courses      Course[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Note {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  content     String      @db.Text
  status      NoteStatus  @default(DRAFT)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        NoteTag[]
  attachments Attachment[]
  resources   Resource[]
  versions    NoteVersion[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, updatedAt])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  notes     NoteTag[]
  createdAt DateTime  @default(now())
}

model NoteTag {
  noteId String
  tagId  String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model Attachment {
  id        String         @id @default(cuid())
  noteId    String
  note      Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  key       String         @unique
  url       String
  kind      AttachmentKind
  createdAt DateTime       @default(now())
}

model Resource {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
}

model NoteVersion {
  id        String     @id @default(cuid())
  noteId    String
  note      Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title     String
  content   String     @db.Text
  status    NoteStatus
  createdAt DateTime   @default(now())
}

// ── Courses ────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String       @db.Text
  coverUrl    String?
  status      CourseStatus @default(DRAFT)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, updatedAt])
}

model Chapter {
  id          String              @id @default(cuid())
  courseId    String
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Chapter?            @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subchapters Chapter[]           @relation("ChapterHierarchy")
  title       String
  content     String              @db.Text
  order       Int
  resources   ChapterResource[]
  attachments ChapterAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([courseId, parentId, order])
  @@index([courseId, order])
  @@index([courseId, parentId, order])
}

model ChapterResource {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
}

model ChapterAttachment {
  id        String         @id @default(cuid())
  chapterId String
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  key       String         @unique
  url       String
  kind      AttachmentKind
  createdAt DateTime       @default(now())
}
